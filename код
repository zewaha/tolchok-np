
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0b1020">
<title>Tolchok NP — BETA</title>

<style>
:root {
 --bg:#0b1020;
 --panel:#17243a;
 --panel2:#111e32;
 --green:#55edb0;
 --text:#f4f6ff;
 --muted:#aab9cb;
 --border:#30425b;
 --yellow:#ffd45c;
}

* {
 box-sizing:border-box;
}

html {
 scroll-behavior:smooth;
}

body {
 margin:0;
 background:var(--bg);
 color:var(--text);
 font-family:Arial,sans-serif;
 overflow-x:hidden;
}

button,input,textarea,select {
 font:inherit;
}

button {
 cursor:pointer;
}

/* HEADER */

header {
 position:relative;
 overflow:hidden;
 text-align:center;
 padding:38px 15px;
 background:
 radial-gradient(circle at 15% 20%,#1d765b 0,transparent 40%),
 radial-gradient(circle at 90% 10%,#47337a 0,transparent 35%),
 linear-gradient(135deg,#142c42,#102d2c);
 border-bottom:1px solid #315a50;
}

.logo {
 font-size:clamp(30px,8vw,44px);
 font-weight:1000;
 color:var(--green);
 text-shadow:0 0 25px #55edb055;
 animation:fadeIn .7s ease;
}

header p {
 color:#c5d7e6;
 margin:10px 0;
}

.beta {
 display:inline-flex;
 align-items:center;
 gap:7px;
 padding:8px 16px;
 margin-top:12px;
 border:1px solid #55edb077;
 border-radius:30px;
 background:#55edb018;
 color:var(--green);
 font-size:12px;
 font-weight:bold;
 letter-spacing:1px;
 animation:betaPulse 2s infinite;
}

.beta-dot {
 width:7px;
 height:7px;
 border-radius:50%;
 background:var(--green);
 box-shadow:0 0 10px var(--green);
}

.floating {
 position:absolute;
 font-size:25px;
 opacity:.35;
 pointer-events:none;
 animation:floatUp 4s ease-in-out infinite;
}

.f1 {top:15px;left:8%}
.f2 {top:65px;right:9%;animation-delay:1s}
.f3 {bottom:15px;left:20%;animation-delay:2s}
.f4 {bottom:18px;right:20%;animation-delay:.5s}

@keyframes floatUp {
 0%,100% {transform:translateY(0)}
 50% {transform:translateY(-12px)}
}

@keyframes betaPulse {
 50% {box-shadow:0 0 17px #55edb044}
}

@keyframes fadeIn {
 from {opacity:0;transform:translateY(-12px)}
 to {opacity:1;transform:translateY(0)}
}

/* MAIN */

.container {
 max-width:950px;
 margin:auto;
 padding:16px;
}

h2 {
 font-size:21px;
 margin:28px 0 15px;
}

.muted {
 color:var(--muted);
 font-size:13px;
}

/* STATS */

.stats {
 display:grid;
 grid-template-columns:repeat(3,1fr);
 gap:9px;
 margin:20px 0;
}

.stat {
 background:var(--panel);
 border:1px solid var(--border);
 border-radius:16px;
 padding:17px 5px;
 text-align:center;
 transition:.25s;
 animation:fadeIn .5s ease;
}

.stat:hover {
 border-color:var(--green);
 transform:translateY(-4px);
}

.stat strong {
 display:block;
 font-size:24px;
 color:var(--green);
 margin-bottom:5px;
}

.stat span {
 font-size:11px;
 color:var(--muted);
}

/* INPUTS */

input,textarea,select {
 width:100%;
 padding:15px;
 margin:7px 0;
 color:white;
 background:var(--panel2);
 border:1px solid var(--border);
 border-radius:13px;
 outline:none;
 transition:.25s;
}

input:focus,textarea:focus,select:focus {
 border-color:var(--green);
 box-shadow:0 0 0 4px #55edb019;
}

select option {
 background:#17243a;
}

textarea {
 min-height:100px;
 resize:vertical;
}

/* SEARCH */

.search-wrap {
 position:relative;
 margin-bottom:10px;
}

.search-wrap input {
 height:62px;
 padding:15px 52px;
 margin:0;
 border-radius:17px;
 font-size:16px;
}

.search-icon {
 position:absolute;
 left:17px;
 top:50%;
 transform:translateY(-50%);
 font-size:23px;
 pointer-events:none;
 animation:iconPulse 2s infinite;
}

@keyframes iconPulse {
 0%,100% {scale:1}
 50% {scale:1.12}
}

.clear-search {
 display:none;
 position:absolute;
 right:10px;
 top:50%;
 transform:translateY(-50%);
 width:35px;
 height:35px;
 border:0;
 border-radius:50%;
 background:#263750;
 color:white;
 font-size:20px;
}

.clear-search.show {
 display:block;
}

.search-help {
 padding:9px 3px;
 color:var(--muted);
 font-size:12px;
 line-height:1.6;
}

/* SUGGESTIONS */

.suggestions {
 position:absolute;
 z-index:30;
 top:calc(100% + 7px);
 left:0;
 right:0;
 padding:10px;
 background:#192840;
 border:1px solid #435b75;
 border-radius:15px;
 box-shadow:0 15px 40px #0008;
 animation:drop .2s ease;
}

.suggestions.hidden {
 display:none;
}

.suggestion-title {
 color:var(--green);
 font-size:12px;
 font-weight:bold;
 padding:8px;
}

.suggestion {
 width:100%;
 padding:12px;
 display:flex;
 align-items:center;
 gap:12px;
 color:white;
 background:transparent;
 border:0;
 border-radius:10px;
 text-align:left;
 transition:.2s;
}

.suggestion:hover {
 background:#263c53;
}

.suggestion-icon {
 font-size:23px;
 flex-shrink:0;
}

.suggestion-info {
 min-width:0;
 flex:1;
}

.suggestion-info strong {
 display:block;
 font-size:14px;
}

.suggestion-info small {
 display:block;
 margin-top:4px;
 color:var(--muted);
 font-size:11px;
}

.suggestion-empty {
 padding:14px;
 color:var(--muted);
 font-size:13px;
 line-height:1.6;
}

@keyframes drop {
 from {opacity:0;transform:translateY(-8px)}
 to {opacity:1;transform:translateY(0)}
}

/* CATEGORY FILTER ICONS */

.category-heading {
 display:flex;
 justify-content:space-between;
 align-items:center;
 gap:10px;
 margin-top:23px;
}

.category-heading h2 {
 margin:0 0 15px;
}

.filter-status {
 color:var(--green);
 font-size:11px;
 margin-bottom:15px;
}

.filter-grid {
 display:grid;
 grid-template-columns:repeat(3,1fr);
 gap:10px;
}

.filter-card {
 min-width:0;
 position:relative;
 overflow:hidden;
 padding:15px 5px;
 border:1px solid var(--border);
 border-radius:15px;
 background:var(--panel2);
 color:white;
 text-align:center;
 transition:background .25s,border-color .25s,transform .25s;
}

.filter-card:active {
 transform:scale(.95);
}

.filter-card:hover {
 border-color:#55edb088;
 transform:translateY(-3px);
}

.filter-card.active {
 background:#164438;
 border:2px solid var(--green);
 box-shadow:0 0 17px #55edb033;
 animation:cardPop .25s ease;
}

@keyframes cardPop {
 0% {transform:scale(.94)}
 100% {transform:scale(1)}
}

.filter-icon {
 display:block;
 font-size:29px;
 margin-bottom:9px;
 transform:none!important;
 animation:none!important;
}

.filter-name {
 display:block;
 font-size:12px;
 font-weight:bold;
 line-height:1.35;
}

.filter-count {
 display:inline-block;
 margin-top:8px;
 padding:4px 9px;
 border-radius:20px;
 background:#293a50;
 color:#c6d5e5;
 font-size:10px;
}

.filter-card.active .filter-count {
 background:#55edb027;
 color:var(--green);
}

/* CITY AND SORT */

.filters {
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:10px;
 margin-top:15px;
}

.filters select {
 margin:0;
 min-width:0;
}

/* QUICK SEARCH */

.quick-chips {
 display:flex;
 flex-wrap:wrap;
 gap:8px;
 margin:13px 0;
}

.chip {
 border:1px solid var(--border);
 background:#1b2c43;
 color:white;
 border-radius:25px;
 padding:9px 13px;
 font-size:12px;
 transition:.2s;
}

.chip:active {
 transform:scale(.95);
 border-color:var(--green);
}

/* PANELS */

.panel {
 padding:19px;
 margin:23px 0;
 background:var(--panel);
 border:1px solid var(--border);
 border-radius:18px;
 animation:fadeIn .5s ease;
}

.city-grid {
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:12px;
}

.city-button {
 padding:16px 8px;
 background:var(--panel2);
 color:white;
 border:1px solid var(--border);
 border-radius:15px;
 transition:.25s;
}

.city-button .emoji {
 display:block;
 font-size:30px;
 margin-bottom:8px;
 transform:none!important;
}

.city-button.active {
 background:#164438;
 border:2px solid var(--green);
 box-shadow:0 0 17px #55edb033;
}

.category-grid {
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:11px;
}

.category-button {
 padding:15px 11px;
 text-align:left;
 color:white;
 background:var(--panel2);
 border:1px solid var(--border);
 border-radius:15px;
 transition:.25s;
}

.category-button:active {
 transform:scale(.97);
}

.category-button.active {
 background:#164438;
 border:2px solid var(--green);
}

.category-button .emoji {
 display:block;
 font-size:29px;
 margin-bottom:10px;
 transform:none!important;
 animation:none!important;
}

.category-button strong {
 display:block;
 font-size:13px;
}

.category-button small {
 display:block;
 color:var(--muted);
 margin-top:7px;
 font-size:11px;
}

/* BUTTONS */

.primary {
 width:100%;
 padding:15px;
 color:#10251d;
 background:linear-gradient(120deg,#55edb0,#39c9a0);
 border:0;
 border-radius:12px;
 font-weight:bold;
 transition:.25s;
}

.primary:hover {
 box-shadow:0 8px 23px #55edb044;
 transform:translateY(-2px);
}

.primary:active {
 transform:scale(.97);
}

.secondary {
 padding:11px 14px;
 color:white;
 background:#263750;
 border:1px solid #405571;
 border-radius:10px;
 font-size:13px;
}

/* PLACES */

.place {
 position:relative;
 overflow:hidden;
 padding:19px;
 margin:14px 0;
 background:linear-gradient(145deg,#1a2941,#142137);
 border:1px solid var(--border);
 border-radius:18px;
 animation:placeIn .45s ease both;
 transition:.25s;
}

.place:hover {
 border-color:#55edb077;
 transform:translateY(-3px);
}

.place:before {
 content:"";
 position:absolute;
 top:0;
 left:0;
 width:4px;
 height:100%;
 background:var(--green);
 opacity:.6;
}

@keyframes placeIn {
 from {opacity:0;transform:translateY(15px)}
 to {opacity:1;transform:translateY(0)}
}

.place-title {
 font-size:19px;
 font-weight:bold;
 margin-bottom:12px;
 overflow-wrap:anywhere;
}

.place-meta {
 color:var(--muted);
 font-size:13px;
 line-height:1.8;
}

.place-rating {
 color:var(--yellow);
 font-size:20px;
 font-weight:bold;
 margin:14px 0 7px;
}

.place-actions {
 display:flex;
 flex-wrap:wrap;
 gap:8px;
 margin-top:15px;
}

.map-link {
 text-decoration:none;
 display:inline-flex;
 align-items:center;
}

.review {
 padding:13px;
 margin-top:11px;
 background:#0d192b;
 border:1px solid #273a51;
 border-radius:12px;
 overflow-wrap:anywhere;
 animation:fadeIn .3s ease;
}

.review-name {
 color:var(--green);
 font-weight:bold;
}

.review-stars {
 color:var(--yellow);
 margin:7px 0;
}

.review-date {
 font-size:11px;
 color:var(--muted);
 margin-top:9px;
}

/* RATING */

.rating-buttons {
 display:flex;
 justify-content:center;
 gap:7px;
 margin:12px 0;
}

.star-button {
 width:47px;
 height:47px;
 font-size:27px;
 color:#718096;
 background:#263750;
 border:1px solid #405571;
 border-radius:10px;
 transition:.2s;
}

.star-button.active {
 color:var(--yellow);
 background:#3d351f;
 border-color:var(--yellow);
 transform:translateY(-2px);
}

/* NOTICE */

.notice {
 padding:14px;
 background:#142c2b;
 border:1px solid #28624f;
 border-radius:13px;
 color:#a8ebd1;
 font-size:12px;
 line-height:1.7;
}

.empty {
 padding:30px 15px;
 text-align:center;
 color:var(--muted);
 background:var(--panel);
 border:1px dashed #40536e;
 border-radius:16px;
 line-height:1.7;
}

/* TOAST */

.toast {
 position:fixed;
 bottom:25px;
 left:50%;
 z-index:100;
 width:max-content;
 max-width:90%;
 padding:14px 19px;
 border:1px solid #55edb077;
 border-radius:13px;
 background:#173b32;
 color:white;
 box-shadow:0 8px 30px #0008;
 opacity:0;
 transform:translate(-50%,20px);
 pointer-events:none;
 transition:.3s;
 font-size:14px;
}

.toast.show {
 opacity:1;
 transform:translate(-50%,0);
}

.hidden {
 display:none!important;
}

/* FOOTER */

footer {
 text-align:center;
 padding:35px 15px;
 color:#8292a8;
 font-size:13px;
 border-top:1px solid #24334a;
 margin-top:35px;
}

footer strong {
 color:var(--green);
}

@media(max-width:430px) {
 .container {padding:12px}
 .filter-grid {gap:7px}
 .filter-card {padding:13px 3px}
 .filter-name {font-size:11px}
 .filter-icon {font-size:26px}
 .stats {gap:6px}
 .stat strong {font-size:21px}
 .star-button {width:43px;height:45px}
}

@media(prefers-reduced-motion:reduce) {
 *,*::before,*::after {
  animation:none!important;
  transition:none!important;
  scroll-behavior:auto!important;
 }
}
</style>
</head>

<body>

<header>
 <div class="floating f1">🚽</div>
 <div class="floating f2">⭐</div>
 <div class="floating f3">✨</div>
 <div class="floating f4">🏆</div>

 <div class="logo">🚽 TOLCHOK NP</div>
 <p>Городской рейтинг туалетов</p>
 <p>Новополоцк · Полоцк</p>

 <div class="beta">
  <span class="beta-dot"></span>
  BETA VERSION 5.0
 </div>
</header>

<main class="container">

<!-- STATISTICS -->

<div class="stats">
 <div class="stat">
  <strong id="totalPlaces">0</strong>
  <span>🚽 Мест</span>
 </div>

 <div class="stat">
  <strong id="totalReviews">0</strong>
  <span>💬 Отзывов</span>
 </div>

 <div class="stat">
  <strong id="average">—</strong>
  <span>⭐ Средняя оценка</span>
 </div>
</div>

<!-- SEARCH -->

<h2>🔍 Найти место</h2>

<div class="search-wrap">
 <span class="search-icon">🔎</span>

 <input id="search"
  type="search"
  autocomplete="off"
  placeholder="Название, адрес или улица...">

 <button id="clearSearch"
  class="clear-search"
  type="button">×</button>

 <div id="suggestions"
  class="suggestions hidden"></div>
</div>

<div class="search-help">
 💡 Начни вводить название, улицу или город.
 Сайт предложит подходящие места из каталога.
</div>

<div class="quick-chips">
 <button class="chip" data-city="Новополоцк">🏙️ Новополоцк</button>
 <button class="chip" data-city="Полоцк">🏛️ Полоцк</button>
 <button class="chip" data-category="Торговый центр">🏬 ТЦ</button>
</div>

<!-- NEW CATEGORY FILTER -->

<div class="category-heading">
 <h2>📂 Категории</h2>
</div>

<div class="filter-status" id="filterStatus">
 ✨ Выбери категорию для поиска
</div>

<div class="filter-grid">

 <button class="filter-card active"
  data-filter="all"
  aria-pressed="true">

  <span class="filter-icon">🗂️</span>
  <span class="filter-name">Все места</span>
  <span class="filter-count" id="count-all">0</span>

 </button>

 <button class="filter-card"
  data-filter="Общественный туалет"
  aria-pressed="false">

  <span class="filter-icon">🚻</span>
  <span class="filter-name">Общественные</span>
  <span class="filter-count" id="count-public">0</span>

 </button>

 <button class="filter-card"
  data-filter="Торговый центр"
  aria-pressed="false">

  <span class="filter-icon">🏬</span>
  <span class="filter-name">Торговые центры</span>
  <span class="filter-count" id="count-mall">0</span>

 </button>

 <button class="filter-card"
  data-filter="Кафе или заведение"
  aria-pressed="false">

  <span class="filter-icon">🍔</span>
  <span class="filter-name">Кафе</span>
  <span class="filter-count" id="count-cafe">0</span>

 </button>

 <button class="filter-card"
  data-filter="Другое"
  aria-pressed="false">

  <span class="filter-icon">📍</span>
  <span class="filter-name">Другое</span>
  <span class="filter-count" id="count-other">0</span>

 </button>

</div>

<!-- FILTERS -->

<div class="filters">

 <select id="cityFilter">
  <option value="all">🌍 Все города</option>
  <option value="Новополоцк">🏙️ Новополоцк</option>
  <option value="Полоцк">🏛️ Полоцк</option>
 </select>

 <select id="sort">
  <option value="rating">🏆 Лучший рейтинг</option>
  <option value="reviews">💬 Больше отзывов</option>
  <option value="new">🆕 Сначала новые</option>
 </select>

</div>

<!-- PLACES -->

<h2>🏆 Рейтинг мест</h2>

<div id="places"></div>

<!-- ADD PLACE -->

<section class="panel">

 <h2>➕ Добавить туалет</h2>

 <p class="muted">
  Помоги другим найти хорошее место!
 </p>

 <form id="placeForm">

  <p class="muted">📍 Выбери город</p>

  <div class="city-grid">

   <button type="button"
    class="city-button active"
    data-city="Новополоцк">

    <span class="emoji">🏙️</span>
    <strong>Новополоцк</strong>

   </button>

   <button type="button"
    class="city-button"
    data-city="Полоцк">

    <span class="emoji">🏛️</span>
    <strong>Полоцк</strong>

   </button>

  </div>

  <p class="muted" style="margin-top:20px">
   🚻 Выбери категорию
  </p>

  <div class="category-grid">

   <button type="button"
    class="category-button active"
    data-category="Общественный туалет">

    <span class="emoji">🚻</span>
    <strong>Общественный туалет</strong>
    <small>Городские уборные</small>

   </button>

   <button type="button"
    class="category-button"
    data-category="Торговый центр">

    <span class="emoji">🏬</span>
    <strong>Торговый центр</strong>
    <small>Туалеты в ТЦ</small>

   </button>

   <button type="button"
    class="category-button"
    data-category="Кафе или заведение">

    <span class="emoji">🍔</span>
    <strong>Кафе или заведение</strong>
    <small>Кафе и рестораны</small>

   </button>

   <button type="button"
    class="category-button"
    data-category="Другое">

    <span class="emoji">📍</span>
    <strong>Другое</strong>
    <small>Другие места</small>

   </button>

  </div>

  <input type="hidden"
   id="selectedCity"
   value="Новополоцк">

  <input type="hidden"
   id="selectedCategory"
   value="Общественный туалет">

  <p class="muted">📝 Информация о месте</p>

  <input id="placeName"
   placeholder="🏷️ Название места"
   maxlength="70"
   required>

  <input id="placeAddress"
   placeholder="📍 Улица, дом или адрес"
   maxlength="150"
   required>

  <button type="submit" class="primary">
   🚀 Добавить в каталог
  </button>

 </form>
</section>

<!-- REVIEW -->

<section class="panel hidden" id="reviewPanel">

 <h2>⭐ Оставить отзыв</h2>

 <p id="reviewPlace" class="muted"></p>

 <form id="reviewForm">

  <input id="nickname"
   placeholder="👤 Твой никнейм (необязательно)"
   maxlength="30">

  <p class="muted">Как тебе это место?</p>

  <div class="rating-buttons">

   <button type="button" class="star-button active" data-stars="1">★</button>
   <button type="button" class="star-button active" data-stars="2">★</button>
   <button type="button" class="star-button active" data-stars="3">★</button>
   <button type="button" class="star-button active" data-stars="4">★</button>
   <button type="button" class="star-button active" data-stars="5">★</button>

  </div>

  <p id="ratingLabel"
   style="text-align:center;color:#ffd45c">
   ⭐ 5 из 5 — Отлично!
  </p>

  <input type="hidden" id="stars" value="5">

  <textarea id="comment"
   maxlength="500"
   placeholder="💬 Напиши свой отзыв..."
   required></textarea>

  <button type="submit" class="primary">
   ✨ Опубликовать отзыв
  </button>

  <button type="button"
   id="cancelReview"
   class="secondary"
   style="width:100%;margin-top:10px">
   Отмена
  </button>

 </form>
</section>

<div class="notice">
 🛡️ TOLCHOK NP BETA — тестовая версия проекта.
