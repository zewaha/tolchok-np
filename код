<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tolchok NP — отзывы Новополоцка</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #0b1020;
  color: #f4f6ff;
  font-family: Arial, sans-serif;
}

header {
  padding: 35px 15px;
  text-align: center;
  background: linear-gradient(135deg, #172b45, #075b48);
  border-bottom: 1px solid #31435a;
}

.logo {
  font-size: 34px;
  font-weight: 900;
  color: #55edb0;
}

header p {
  color: #c3d3e5;
}

.container {
  max-width: 900px;
  margin: auto;
  padding: 20px;
}

h2 {
  margin-top: 30px;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin: 20px 0;
}

.stat {
  background: #172238;
  border: 1px solid #2c3d55;
  border-radius: 14px;
  padding: 17px 8px;
  text-align: center;
}

.stat strong {
  display: block;
  font-size: 25px;
  color: #55edb0;
}

.stat span {
  font-size: 12px;
  color: #aab9cb;
}

.panel {
  background: #172238;
  border: 1px solid #2c3d55;
  border-radius: 15px;
  padding: 18px;
  margin: 20px 0;
}

input, textarea, select {
  width: 100%;
  padding: 13px;
  margin: 7px 0;
  background: #0d1729;
  color: white;
  border: 1px solid #344760;
  border-radius: 9px;
  font-size: 15px;
}

textarea {
  resize: vertical;
  min-height: 85px;
}

button {
  padding: 12px 17px;
  border: none;
  border-radius: 9px;
  background: #55edb0;
  color: #10251d;
  font-weight: bold;
  cursor: pointer;
}

button:hover {
  opacity: .85;
}

.review-button {
  width: 100%;
  margin-top: 12px;
}

.place {
  background: #172238;
  border: 1px solid #2c3d55;
  padding: 19px;
  margin: 14px 0;
  border-radius: 15px;
}

.place h3 {
  margin: 0 0 10px;
  font-size: 20px;
}

.address {
  color: #aab9cb;
  font-size: 14px;
}

.rating {
  color: #ffd45c;
  font-size: 18px;
  font-weight: bold;
}

.review {
  background: #0e192b;
  border-radius: 10px;
  padding: 12px;
  margin-top: 10px;
  overflow-wrap: anywhere;
}

.review small {
  color: #9aabc0;
}

.empty {
  text-align: center;
  color: #aab9cb;
  padding: 30px 10px;
}

.hidden {
  display: none;
}

footer {
  text-align: center;
  color: #8292a8;
  padding: 30px;
  font-size: 13px;
}

@media(max-width: 500px) {
  .stats {
    gap: 6px;
  }

  .stat {
    padding: 13px 4px;
  }

  .stat strong {
    font-size: 20px;
  }
}
</style>
</head>

<body>

<header>
  <div class="logo">🚽 TOLCHOK NP</div>
  <p>Главный рейтинг туалетов Новополоцка</p>
  <p>Честные отзывы. Реальные оценки. Твой город.</p>
</header>

<main class="container">

  <div class="stats">
    <div class="stat">
      <strong id="totalPlaces">0</strong>
      <span>Туалетов</span>
    </div>
    <div class="stat">
      <strong id="totalReviews">0</strong>
      <span>Отзывов</span>
    </div>
    <div class="stat">
      <strong id="average">—</strong>
      <span>Средняя оценка</span>
    </div>
  </div>

  <section>
    <h2>🔎 Найти толчок</h2>

    <input
      id="search"
      placeholder="Название или адрес..."
    >

    <select id="sort">
      <option value="rating">Сначала лучшие</option>
      <option value="reviews">По количеству отзывов</option>
      <option value="new">Сначала новые</option>
    </select>
  </section>

  <section>
    <h2>🏆 Рейтинг Новополоцка</h2>
    <div id="places"></div>
  </section>

  <section class="panel">
    <h2>➕ Добавить туалет</h2>

    <form id="placeForm">
      <input
        id="placeName"
        placeholder="Название места"
        maxlength="70"
        required
      >

      <input
        id="placeAddress"
        placeholder="Адрес в Новополоцке"
        maxlength="120"
        required
      >

      <select id="category">
        <option>Общественный туалет</option>
        <option>Торговый центр</option>
        <option>Кафе или заведение</option>
        <option>Другое</option>
      </select>

      <button type="submit">Добавить место</button>
    </form>
  </section>

  <section class="panel hidden" id="reviewPanel">
    <h2>⭐ Оставить отзыв</h2>
    <p id="reviewPlace"></p>

    <form id="reviewForm">
      <input
        id="nickname"
        placeholder="Никнейм (необязательно)"
        maxlength="30"
      >

      <select id="stars">
        <option value="5">⭐⭐⭐⭐⭐ — Отлично</option>
        <option value="4">⭐⭐⭐⭐ — Хорошо</option>
        <option value="3">⭐⭐⭐ — Нормально</option>
        <option value="2">⭐⭐ — Плохо</option>
        <option value="1">⭐ — Ужасно</option>
      </select>

      <textarea
        id="comment"
        placeholder="Расскажи о своём впечатлении..."
        maxlength="500"
        required
      ></textarea>

      <button type="submit">Опубликовать отзыв</button>
      <button type="button" id="cancelReview"
        style="background:#52627a;color:white;margin-top:8px">
        Отмена
      </button>
    </form>
  </section>

  <p style="color:#8292a8;font-size:12px">
    Отзывы должны быть честными и не содержать личных данных,
    оскорблений или неподтверждённых обвинений.
  </p>

</main>

<footer>
  🚽 Tolchok NP © 2026
  <br>
  Проект о туалетах Новополоцка
</footer>

<script>

// Хранение данных
let places = [];

try {
  places = JSON.parse(
    localStorage.getItem("tolchokNP") || "[]"
  );

  if (!Array.isArray(places)) places = [];
} catch {
  places = [];
}

let selectedPlace = null;

function save() {
  try {
    localStorage.setItem(
      "tolchokNP",
      JSON.stringify(places)
    );
  } catch {
    alert("Не удалось сохранить данные браузера.");
  }
}

function average(place) {
  if (!place.reviews.length) return 0;

  return place.reviews.reduce(
    (sum, r) => sum + r.stars, 0
  ) / place.reviews.length;
}

// Статистика
function updateStats() {
  const reviews = places.reduce(
    (sum, p) => sum + p.reviews.length, 0
  );

  const allRatings = places.flatMap(
    p => p.reviews.map(r => r.stars)
  );

  const avg = allRatings.length
    ? allRatings.reduce((a,b) => a+b, 0) /
      allRatings.length
    : null;

  document.getElementById("totalPlaces")
    .textContent = places.length;

  document.getElementById("totalReviews")
    .textContent = reviews;

  document.getElementById("average")
    .textContent = avg === null ? "—" : avg.toFixed(1);
}

// Создание элемента с безопасным текстом
function element(tag, className, text) {
  const el = document.createElement(tag);

  if (className) el.className = className;
  if (text !== undefined) el.textContent = text;

  return el;
}

// Отображение мест
function render() {
  const container = document.getElementById("places");
  container.replaceChildren();

  const search = document.getElementById("search")
    .value.trim().toLowerCase();

  let filtered = places.filter(p =>
    (p.name + " " + p.address + " " + p.category)
      .toLowerCase().includes(search)
  );

  const sort = document.getElementById("sort").value;

  if (sort === "rating") {
    filtered.sort((a,b) => average(b)-average(a));
  }

  if (sort === "reviews") {
    filtered.sort((a,b) =>
      b.reviews.length-a.reviews.length
    );
  }

  if (sort === "new") {
    filtered.sort((a,b) => b.createdAt-a.createdAt);
  }

  if (!filtered.length) {
    container.appendChild(
      element("div", "empty",
        places.length
          ? "Ничего не найдено."
          : "Пока здесь нет туалетов. Добавь первый!")
    );
  }

  filtered.forEach(place => {
    const card = element("div", "place");

    card.appendChild(
      element("h3", "", "🚽 " + place.name)
    );

    card.appendChild(
      element("p", "address",
        "📍 " + place.address)
    );

    card.appendChild(
      element("small", "", place.category)
    );

    const score = place.reviews.length
      ? average(place).toFixed(1) + " / 5"
      : "Нет оценок";

    card.appendChild(
      element("p", "rating",
        "⭐ " + score +
        " · " + place.reviews.length + " отзывов")
    );

    place.reviews.forEach(review => {
      const item = element("div", "review");

      item.appendChild(
        element("strong", "",
          review.nickname || "Аноним")
      );

      item.appendChild(
        element("p", "",
          "⭐".repeat(review.stars))
      );

      item.appendChild(
        element("p", "", review.comment)
      );

      item.appendChild(
        element("small", "",
          new Date(review.date).toLocaleDateString("ru-RU"))
      );

      card.appendChild(item);
    });

    const button = element(
      "button", "review-button", "✍️ Оставить отзыв"
    );

    button.addEventListener("click", () => {
      selectedPlace = place.id;

      document.getElementById("reviewPlace")
        .textContent = "Место: " + place.name;

      document.getElementById("reviewPanel")
        .classList.remove("hidden");

      document.getElementById("reviewPanel")
        .scrollIntoView({behavior:"smooth"});
    });

    card.appendChild(button);
    container.appendChild(card);
  });

  updateStats();
}

// Добавление туалета
document.getElementById("placeForm")
  .addEventListener("submit", function(e) {
    e.preventDefault();

    const name = document.getElementById("placeName")
      .value.trim();

    const address = document.getElementById("placeAddress")
      .value.trim();

    const category = document.getElementById("category")
      .value;

    if (!name || !address) return;

    const exists = places.some(p =>
      p.name.toLowerCase() === name.toLowerCase() &&
      p.address.toLowerCase() === address.toLowerCase()
    );

    if (exists) {
      alert("Такое место уже добавлено!");
      return;
    }

    places.push({
      id: Date.now().toString(),
      name,
      address,
      category,
      createdAt: Date.now(),
      reviews: []
    });

    save();
    render();
    this.reset();

    alert("Место добавлено!");
  });

// Добавление отзыва
document.getElementById("reviewForm")
  .addEventListener("submit", function(e) {
    e.preventDefault();

    const place = places.find(
      p => p.id === selectedPlace
    );

    if (!place) return;

    const nickname = document.getElementById("nickname")
      .value.trim();

    const comment = document.getElementById("comment")
      .value.trim();

    const stars = Number(
      document.getElementById("stars").value
    );

    if (!comment) return;

    place.reviews.push({
      nickname: nickname || "Аноним",
      comment,
      stars,
      date: Date.now()
    });

    save();
    render();

    this.reset();

    document.getElementById("reviewPanel")
      .classList.add("hidden");

    selectedPlace = null;

    alert("Спасибо! Отзыв добавлен.");
  });

document.getElementById("cancelReview")
  .addEventListener("click", () => {
    selectedPlace = null;

    document.getElementById("reviewPanel")
      .classList.add("hidden");
  });

// Поиск и сортировка
document.getElementById("search")
  .addEventListener("input", render);

document.getElementById("sort")
  .addEventListener("change", render);

render();

</script>
</body>
</html>

/* TOLCHOK NP — CUSTOM ANIMATIONS */

.tnp-picker-title {
  font-size: 17px;
  font-weight: bold;
  margin: 20px 0 12px;
  color: #f4f6ff;
}

.tnp-city-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.tnp-city, .tnp-category {
  background: #111d31;
  color: white;
  border: 1px solid #344760;
  border-radius: 14px;
  padding: 17px 12px;
  cursor: pointer;
  text-align: left;
  transition: all .25s ease;
  position: relative;
  overflow: hidden;
}

.tnp-city {
  text-align: center;
}

.tnp-city span, .tnp-category span {
  display: block;
  font-size: 25px;
  margin-bottom: 8px;
}

.tnp-city strong, .tnp-category strong {
  font-size: 14px;
}

.tnp-category small {
  display: block;
  color: #aab9cb;
  margin-top: 6px;
  font-size: 12px;
}

.tnp-category-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.tnp-city.active,
.tnp-category.active {
  border: 2px solid #55edb0;
  background: #153c35;
  box-shadow: 0 0 18px #55edb044;
  transform: translateY(-3px);
  animation: tnp-pop .3s ease;
}

.tnp-city:active,
.tnp-category:active {
  transform: scale(.95);
}

@keyframes tnp-pop {
  0% { transform: scale(.94); }
  60% { transform: scale(1.04); }
  100% { transform: scale(1); }
}

.tnp-category:hover,
.tnp-city:hover {
  border-color: #55edb0;
  background: #1b3445;
}

.tnp-category.active small {
  color: #a5f5d1;
}

#category {
  display: none !important;
}

@media(max-width:400px) {
  .tnp-category-grid {
    gap: 8px;
  }

  .tnp-category {
    padding: 14px 9px;
  }
}
