 Сделано для городского сообщества ✨
</footer>

<div class="toast" id="toast"></div>

<script>

/* ===================================
   TOLCHOK NP 5.0
   =================================== */

const STORAGE_KEY = "tolchokNP_v3";

let places = [];
let selectedPlaceId = null;
let selectedStars = 5;
let selectedFilter = "all";
let toastTimer;

// LOAD

try {
 const saved = JSON.parse(
  localStorage.getItem(STORAGE_KEY) || "[]"
 );

 if (Array.isArray(saved)) {
  places = saved.filter(p =>
   p &&
   typeof p.id === "string" &&
   typeof p.name === "string" &&
   typeof p.address === "string" &&
   Array.isArray(p.reviews)
  ).map(p => ({
   ...p,
   city: p.city === "Полоцк"
    ? "Полоцк"
    : "Новополоцк",
   category: p.category || "Общественный туалет",
   createdAt: Number(p.createdAt) || Date.now(),
   reviews: p.reviews.filter(r =>
    r &&
    typeof r.comment === "string" &&
    Number(r.stars) >= 1 &&
    Number(r.stars) <= 5
   )
  }));
 }
} catch(e) {
 places = [];
}

// HELPERS

function el(tag,cls,text) {
 const node = document.createElement(tag);

 if (cls) node.className = cls;
 if (text !== undefined) node.textContent = text;

 return node;
}

function save() {
 try {
  localStorage.setItem(
   STORAGE_KEY,
   JSON.stringify(places)
  );
 } catch(e) {
  showToast("⚠️ Ошибка сохранения");
 }
}

function showToast(message) {
 const toast = document.getElementById("toast");

 toast.textContent = message;
 toast.classList.add("show");

 clearTimeout(toastTimer);

 toastTimer = setTimeout(() => {
  toast.classList.remove("show");
 },2500);
}

function average(place) {
 if (!place.reviews.length) return 0;

 return place.reviews.reduce(
  (sum,r) => sum + Number(r.stars),0
 ) / place.reviews.length;
}

// STATISTICS

function updateStats() {

 const totalReviews = places.reduce(
  (sum,p) => sum + p.reviews.length,0
 );

 const ratings = places.flatMap(
  p => p.reviews.map(r => Number(r.stars))
 );

 const avg = ratings.length
  ? ratings.reduce((a,b) => a+b,0) / ratings.length
  : null;

 document.getElementById("totalPlaces")
  .textContent = places.length;

 document.getElementById("totalReviews")
  .textContent = totalReviews;

 document.getElementById("average")
  .textContent = avg === null ? "—" : avg.toFixed(1);

}

// CATEGORY COUNTERS

function updateCategoryCounts() {

 const counts = {
  all:places.length,
  public:0,
  mall:0,
  cafe:0,
  other:0
 };

 places.forEach(p => {

  if (p.category === "Общественный туалет")
   counts.public++;

  if (p.category === "Торговый центр")
   counts.mall++;

  if (p.category === "Кафе или заведение")
   counts.cafe++;

  if (p.category === "Другое")
   counts.other++;

 });

 document.getElementById("count-all").textContent = counts.all;
 document.getElementById("count-public").textContent = counts.public;
 document.getElementById("count-mall").textContent = counts.mall;
 document.getElementById("count-cafe").textContent = counts.cafe;
 document.getElementById("count-other").textContent = counts.other;

}

// CATEGORY FILTER FUNCTIONALITY

const categoryLabels = {
 all:"Все места",
 "Общественный туалет":"Общественные туалеты",
 "Торговый центр":"Торговые центры",
 "Кафе или заведение":"Кафе и заведения",
 "Другое":"Другие места"
};

document.querySelectorAll(".filter-card").forEach(button => {

 button.addEventListener("click",() => {

  selectedFilter = button.dataset.filter;

  document.querySelectorAll(".filter-card")
   .forEach(b => {
    const active = b === button;
    b.classList.toggle("active",active);
    b.setAttribute("aria-pressed",String(active));
   });

  document.getElementById("filterStatus")
   .textContent = "✨ Выбрано: " + categoryLabels[selectedFilter];

  render();

 });

});

// SEARCH

const searchInput = document.getElementById("search");
const suggestions = document.getElementById("suggestions");
const clearSearch = document.getElementById("clearSearch");

function closeSuggestions() {
 suggestions.classList.add("hidden");
}

function updateClear() {
 clearSearch.classList.toggle(
  "show",
  searchInput.value.length > 0
 );
}

function showSuggestions() {

 const query = searchInput.value.trim().toLowerCase();

 suggestions.replaceChildren();

 suggestions.appendChild(
  el("div","suggestion-title",
   query ? "🔍 Результаты поиска" : "✨ Популярные места"
  )
 );

 let matches = places.filter(p =>
  (
   p.name + " " +
   p.address + " " +
   p.city + " " +
   p.category
  ).toLowerCase().includes(query)
 );

 if (!query) {
  matches = [...places].sort(
   (a,b) => b.reviews.length-a.reviews.length
  );
 }

 matches = matches.slice(0,6);

 if (!matches.length) {

  suggestions.appendChild(
   el(
    "div",
    "suggestion-empty",
    query
     ? "🤔 Ничего не найдено. Попробуй другое название или улицу. Можно также добавить это место в каталог!"
     : "Пока нет мест. Добавь первое!"
   )
  );

 } else {

  matches.forEach(place => {

   const button = el("button","suggestion");
   button.type = "button";

   const icon = el(
    "span",
    "suggestion-icon",
    place.category === "Торговый центр" ? "🏬" :
    place.category === "Кафе или заведение" ? "🍔" :
    place.category === "Другое" ? "📍" : "🚻"
   );

   const info = el("div","suggestion-info");

   info.appendChild(el("strong","",place.name));

   info.appendChild(
    el("small","",
     "📍 " + place.city + " · " + place.address
    )
   );

   button.append(icon,info);

   button.addEventListener("click",() => {
    searchInput.value = place.name;
    updateClear();
    closeSuggestions();
    render();
   });

   suggestions.appendChild(button);

  });

 }

 suggestions.classList.remove("hidden");
}

searchInput.addEventListener("focus",showSuggestions);

searchInput.addEventListener("input",() => {
 updateClear();
 showSuggestions();
 render();
});

clearSearch.addEventListener("click",() => {
 searchInput.value = "";
 updateClear();
 render();
 showSuggestions();
 searchInput.focus();
});

searchInput.addEventListener("keydown",e => {
 if (e.key === "Escape") closeSuggestions();

 if (e.key === "Enter") {
  closeSuggestions();
  render();
  searchInput.blur();
 }
});

document.addEventListener("click",e => {
 if (!e.target.closest(".search-wrap")) {
  closeSuggestions();
 }
});

// QUICK CHIPS

document.querySelectorAll(".chip").forEach(button => {

 button.addEventListener("click",() => {

  if (button.dataset.city) {
   document.getElementById("cityFilter").value =
    button.dataset.city;
  }

  if (button.dataset.category) {

   selectedFilter = button.dataset.category;

   document.querySelectorAll(".filter-card")
    .forEach(b => {
     const active =
      b.dataset.filter === selectedFilter;

     b.classList.toggle("active",active);
     b.setAttribute("aria-pressed",String(active));
    });

   document.getElementById("filterStatus")
    .textContent = "✨ Выбрано: " +
     categoryLabels[selectedFilter];

  }

  searchInput.value = "";
  updateClear();
  closeSuggestions();
  render();

  document.getElementById("places")
   .scrollIntoView({behavior:"smooth"});

 });

});

// RENDER

function render() {

 const container = document.getElementById("places");

 container.replaceChildren();

 const query = searchInput.value.trim().toLowerCase();

 const city = document.getElementById("cityFilter").value;

 const sort = document.getElementById("sort").value;

 let filtered = places.filter(p => {

  const textMatch = (
   p.name + " " +
   p.address + " " +
   p.city + " " +
   p.category
  ).toLowerCase().includes(query);

  const cityMatch = city === "all" || p.city === city;

  const categoryMatch =
   selectedFilter === "all" ||
   p.category === selectedFilter;

  return textMatch && cityMatch && categoryMatch;

 });

 if (sort === "rating") {

  filtered.sort((a,b) => {

   if (!a.reviews.length && !b.reviews.length) return 0;
   if (!a.reviews.length) return 1;
   if (!b.reviews.length) return -1;

   return average(b)-average(a);

  });

 }

 if (sort === "reviews") {
  filtered.sort((a,b) =>
   b.reviews.length-a.reviews.length
  );
 }

 if (sort === "new") {
  filtered.sort((a,b) =>
   b.createdAt-a.createdAt
  );
 }

 if (!filtered.length) {

  const empty = el("div","empty");

  empty.appendChild(el("div","","🔎"));

  empty.appendChild(
   el(
    "h3",
    "",
    places.length ? "Ничего не найдено" : "Каталог пока пустой"
   )
  );

  empty.appendChild(
   el(
    "p",
    "",
    places.length
     ? "Измени поиск или выбери другую категорию."
     : "Добавь первое место в Tolchok NP!"
   )
  );

  container.appendChild(empty);

 }

 filtered.forEach((place,index) => {

  const card = el("article","place");

  card.style.animationDelay =
   Math.min(index*.05,.4)+"s";

  const icon =
   place.category === "Торговый центр" ? "🏬" :
   place.category === "Кафе или заведение" ? "🍔" :
   place.category === "Другое" ? "📍" : "🚻";

  card.appendChild(
   el("div","place-title",icon+" "+place.name)
  );

  card.appendChild(
   el("div","place-meta",
    "📍 "+place.city+", "+place.address
   )
  );

  card.appendChild(
   el("div","place-meta",
    "📂 "+place.category
   )
  );

  card.appendChild(
   el(
    "div",
    "place-rating",
    place.reviews.length
     ? "⭐ "+average(place).toFixed(1)+" / 5"
     : "⭐ Пока нет оценок"
   )
  );

  card.appendChild(
   el("div","muted",
    "💬 "+place.reviews.length+" отзывов"
   )
  );

  place.reviews.forEach(review => {

   const item = el("div","review");

   item.appendChild(
    el("div","review-name",
     "👤 "+(review.nickname || "Аноним")
    )
   );

   item.appendChild(
    el("div","review-stars",
     "⭐".repeat(review.stars)
    )
   );

   item.appendChild(
    el("div","",review.comment)
   );

   item.appendChild(
    el("div","review-date",
     "🕒 "+new Date(review.date)
      .toLocaleDateString("ru-RU")
    )
   );

   card.appendChild(item);

  });

  const actions = el("div","place-actions");

  const reviewButton = el(
   "button","secondary","✍️ Написать отзыв"
  );

  reviewButton.type = "button";

  reviewButton.addEventListener("click",() => {
   openReview(place);
  });

  actions.appendChild(reviewButton);

  const mapButton = el(
   "a","secondary map-link","🗺️ Карта"
  );

  mapButton.href =
   "https://www.openstreetmap.org/search?query="+
   encodeURIComponent(place.city+", "+place.address);

  mapButton.target = "_blank";
  mapButton.rel = "noopener noreferrer";

  actions.appendChild(mapButton);

  card.appendChild(actions);

  container.appendChild(card);

 });

 updateStats();
 updateCategoryCounts();

}

// ADD PLACE

const selectedCity = document.getElementById("selectedCity");
const selectedCategory = document.getElementById("selectedCategory");

document.querySelectorAll(".city-button").forEach(button => {

 button.addEventListener("click",() => {

  document.querySelectorAll(".city-button")
   .forEach(b => b.classList.remove("active"));

  button.classList.add("active");

  selectedCity.value = button.dataset.city;

 });

});

document.querySelectorAll(".category-button").forEach(button => {

 button.addEventListener("click",() => {

  document.querySelectorAll(".category-button")
   .forEach(b => b.classList.remove("active"));

  button.classList.add("active");

  selectedCategory.value = button.dataset.category;

 });

});

document.getElementById("placeForm")
 .addEventListener("submit",function(e) {

  e.preventDefault();

  const name = document.getElementById("placeName").value.trim();
  const address = document.getElementById("placeAddress").value.trim();

  if (!name || !address) {
   showToast("⚠️ Заполни все поля");
   return;
  }

  const city = selectedCity.value;
  const category = selectedCategory.value;

  const duplicate = places.some(p =>
   p.name.toLowerCase() === name.toLowerCase() &&
   p.address.toLowerCase() === address.toLowerCase() &&
   p.city === city
  );

  if (duplicate) {
   showToast("⚠️ Такое место уже есть!");
   return;
  }

  places.push({
   id:Date.now().toString()+
    Math.random().toString(36).slice(2,8),
   name,
   address,
   city,
   category,
   createdAt:Date.now(),
   reviews:[]
  });

  save();

  this.reset();

  selectedCity.value = "Новополоцк";
  selectedCategory.value = "Общественный туалет";

  document.querySelectorAll(".city-button").forEach(b => {
   b.classList.toggle(
    "active",
    b.dataset.city === "Новополоцк"
   );
  });

  document.querySelectorAll(".category-button").forEach(b => {
   b.classList.toggle(
    "active",
    b.dataset.category === "Общественный туалет"
   );
  });

  render();

  showToast("🎉 Место добавлено!");

  document.getElementById("places")
   .scrollIntoView({behavior:"smooth"});

 });

// REVIEWS

const ratingNames = {
 1:"Ужасно 😖",
 2:"Плохо 😕",
 3:"Нормально 🙂",
 4:"Хорошо 😎",
 5:"Отлично 🤩"
};

function setStars(value) {

 selectedStars = value;

 document.getElementById("stars").value = value;

 document.querySelectorAll(".star-button").forEach(button => {

  button.classList.toggle(
   "active",
   Number(button.dataset.stars) <= value
  );

 });

 document.getElementById("ratingLabel").textContent =
  "⭐ "+value+" из 5 — "+ratingNames[value];

}

document.querySelectorAll(".star-button").forEach(button => {

 button.addEventListener("click",() => {
  setStars(Number(button.dataset.stars));
 });

});

function openReview(place) {

 selectedPlaceId = place.id;

 document.getElementById("reviewPlace").textContent =
  "🚽 "+place.name+" · "+place.city;

 setStars(5);

 const panel = document.getElementById("reviewPanel");

 panel.classList.remove("hidden");

 panel.scrollIntoView({
  behavior:"smooth",
  block:"center"
 });

}

document.getElementById("reviewForm")
 .addEventListener("submit",function(e) {

  e.preventDefault();

  const place = places.find(
   p => p.id === selectedPlaceId
  );

  if (!place) {
   showToast("⚠️ Место не найдено");
   return;
  }

  const nickname =
   document.getElementById("nickname").value.trim();

  const comment =
   document.getElementById("comment").value.trim();

  if (!comment) {
   showToast("Напиши отзыв 💬");
   return;
  }

  place.reviews.push({
   nickname:nickname || "Аноним",
   comment,
   stars:selectedStars,
   date:Date.now()
  });

  save();

  this.reset();

  selectedPlaceId = null;

  document.getElementById("reviewPanel")
   .classList.add("hidden");

  render();

  showToast("⭐ Отзыв опубликован!");

 });

document.getElementById("cancelReview")
 .addEventListener("click",() => {

  selectedPlaceId = null;

  document.getElementById("reviewPanel")
   .classList.add("hidden");

 });

// FILTER EVENTS

document.getElementById("cityFilter")
 .addEventListener("change",render);

document.getElementById("sort")
 .addEventListener("change",render);

// START

updateClear();
render();

</script>

</body>
</html>
